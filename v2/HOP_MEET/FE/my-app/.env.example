# Copy thành file .env rồi sửa. Khởi động lại `npm run dev` sau khi đổi.

# Domain public dùng để tạo link cuộc họp (/meet/{key}).
# Bỏ trống thì link lấy theo địa chỉ đang mở app (localhost sẽ không gửi cho người khác được).
VITE_PUBLIC_URL=https://peroxide-headway-speckled.ngrok-free.dev

# Địa chỉ BE mà Vite proxy /api và /hubs tới. Phải khớp applicationUrl trong launchSettings.json.
BACKEND_URL=https://localhost:7024
