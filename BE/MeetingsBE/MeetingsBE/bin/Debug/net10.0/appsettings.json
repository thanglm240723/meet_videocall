{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MeetingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "your-super-secret-key-at-least-32-characters",
    "Issuer": "MyApi",
    "Audience": "MyClient",
    "ExpireMinutes": 60
  },

  "AllowedHosts": "*"
}